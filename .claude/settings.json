{
  "permissions": {
    "allow": [
      "Bash(node tests/*)",
      "Bash(CHROMIUM_PATH=* node tests/*)",
      "Bash(npx -y http-server . -p 8123*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
